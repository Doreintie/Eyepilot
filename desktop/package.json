{
  "name": "eyepilot-desktop",
  "version": "1.0.1",
  "private": true,
  "description": "EyePilot desktop shell (Electron)",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "app": "node prepare-app.cjs",
    "dist": "node prepare-app.cjs && electron-packager build/app EyePilot --platform=win32 --arch=x64 --out=build/dist --overwrite --asar --app-version=1.0.1"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "@electron/packager": "20.3.0"
  }
}
